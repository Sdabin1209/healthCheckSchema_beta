{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/GeneratorOutput.json",
  "$ref": "#/$defs/GeneratorOutput",
  "$defs": {
    "GeneratorOutput": {
      "type": "object",
      "properties": {
        "response_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "is_fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "response_text",
        "is_fallback"
      ],
      "additionalProperties": false
    }
  }
}