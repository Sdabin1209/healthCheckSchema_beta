{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/RiskRule.json",
  "$ref": "#/$defs/RiskRule",
  "$defs": {
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "RiskRule": {
      "type": "object",
      "properties": {
        "operator": {
          "oneOf": [
            {
              "const": "="
            },
            {
              "const": ">="
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "response": {
          "$ref": "#/$defs/RiskResponse"
        }
      },
      "required": [
        "operator",
        "value",
        "response"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}