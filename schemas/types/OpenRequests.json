{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/OpenRequests.json",
  "$ref": "#/$defs/OpenRequests",
  "$defs": {
    "OpenRequests": {
      "type": "object",
      "properties": {
        "correction_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Target"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "target"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "stop_requested": {
          "type": "boolean"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "oneOf": [
                  {
                    "const": "QUESTION"
                  },
                  {
                    "const": "PENDING"
                  },
                  {
                    "const": "CORRECTION_REQUEST"
                  }
                ]
              },
              "target": {
                "$ref": "#/$defs/Target"
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
        "correction_requests",
        "stop_requested",
        "deferred"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/SlotRef"
        },
        {
          "$ref": "#/$defs/WholeQuestion"
        }
      ]
    },
    "WholeQuestion": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "whole_question": {
          "const": true
        }
      },
      "required": [
        "question_id",
        "whole_question"
      ],
      "additionalProperties": false
    }
  }
}