{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/Judgment.json",
  "$ref": "#/$defs/Judgment",
  "$defs": {
    "Judgment": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/Target"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgmentStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "maxItems": 6,
          "uniqueItems": true
        },
        "value_now": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "said_value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_handling": {
          "oneOf": [
            {
              "const": "CREATE"
            },
            {
              "const": "ACCEPT"
            },
            {
              "const": "DROP"
            },
            {
              "const": "NONE"
            }
          ]
        },
        "target_pending_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingId"
          },
          "maxItems": 20
        },
        "mismatched_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotRef"
          },
          "maxItems": 20
        },
        "risk_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskResponse"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "status",
        "reasons",
        "value_now",
        "said_value",
        "pending_handling",
        "target_pending_ids",
        "mismatched_slots",
        "risk_rule"
      ],
      "additionalProperties": false
    },
    "JudgmentStatus": {
      "oneOf": [
        {
          "const": "ANSWERED"
        },
        {
          "const": "MISSING"
        },
        {
          "const": "UNCLEAR"
        },
        {
          "const": "CONFLICT"
        },
        {
          "const": "CORRECTION"
        },
        {
          "const": "UNKNOWN"
        },
        {
          "const": "REJECTED"
        },
        {
          "const": "PREREQUISITE_UNMET"
        }
      ]
    },
    "PendingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "Reason": {
      "oneOf": [
        {
          "const": "NO_UNIT"
        },
        {
          "const": "OUT_OF_RANGE"
        },
        {
          "const": "AMBIGUOUS"
        },
        {
          "const": "MISMATCH"
        },
        {
          "const": "UNRECOGNIZED"
        },
        {
          "const": "MISSING_SLOT"
        }
      ]
    },
    "RiskResponse": {
      "oneOf": [
        {
          "const": "IMMEDIATE"
        },
        {
          "const": "ON_RESULT"
        }
      ]
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/SlotRef"
        },
        {
          "$ref": "#/$defs/WholeQuestion"
        }
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "WholeQuestion": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "whole_question": {
          "const": true
        }
      },
      "required": [
        "question_id",
        "whole_question"
      ],
      "additionalProperties": false
    }
  }
}