{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/StaffAlertReason.json",
  "$ref": "#/$defs/StaffAlertReason",
  "$defs": {
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "StaffAlertReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "$ref": "#/$defs/SlotRef"
                  },
                  "question_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "value": {
                    "$ref": "#/$defs/Value"
                  }
                },
                "required": [
                  "slot",
                  "question_name",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "USER_CALLED_STAFF"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}