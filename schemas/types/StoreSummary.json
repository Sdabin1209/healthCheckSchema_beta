{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/StoreSummary.json",
  "$ref": "#/$defs/StoreSummary",
  "$defs": {
    "ChangedSlot": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_value": {
          "$ref": "#/$defs/Value"
        },
        "kind": {
          "oneOf": [
            {
              "const": "FIRST_ANSWER"
            },
            {
              "const": "CORRECTION"
            }
          ]
        }
      },
      "required": [
        "slot",
        "previous_value",
        "new_value",
        "kind"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "StoreSummary": {
      "type": "object",
      "properties": {
        "changed_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangedSlot"
          },
          "maxItems": 50
        },
        "unknown_refused_records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "record": {
                "oneOf": [
                  {
                    "const": "UNKNOWN_RECORD"
                  },
                  {
                    "const": "REFUSAL_RECORD"
                  }
                ]
              }
            },
            "required": [
              "slot",
              "record"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "created_pendings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              }
            },
            "required": [
              "slot"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "resolved_pendings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "handling": {
                "oneOf": [
                  {
                    "const": "ACCEPT"
                  },
                  {
                    "const": "DROP"
                  },
                  {
                    "const": "REPLACE"
                  }
                ]
              }
            },
            "required": [
              "slot",
              "handling"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "invalidated_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionId"
          },
          "maxItems": 50,
          "uniqueItems": true
        }
      },
      "required": [
        "changed_slots",
        "unknown_refused_records",
        "created_pendings",
        "resolved_pendings",
        "invalidated_questions"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}