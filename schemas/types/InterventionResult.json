{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/InterventionResult.json",
  "$ref": "#/$defs/InterventionResult",
  "$defs": {
    "InterventionResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "result": {
          "oneOf": [
            {
              "const": "APPLIED"
            },
            {
              "const": "IGNORED"
            },
            {
              "const": "FAILED"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "SessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    }
  }
}