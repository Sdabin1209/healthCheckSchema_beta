{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/SessionSettings.json",
  "$ref": "#/$defs/SessionSettings",
  "$defs": {
    "FillValue": {
      "oneOf": [
        {
          "const": "REMAINING_COUNT"
        }
      ]
    },
    "FixedSentence": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/FixedSentenceKey"
        },
        "sentence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "key",
        "sentence"
      ],
      "additionalProperties": false
    },
    "FixedSentenceKey": {
      "oneOf": [
        {
          "const": "ASK_REPEAT"
        },
        {
          "const": "OOS_NOTICE"
        },
        {
          "const": "CALL_STAFF"
        },
        {
          "const": "FAREWELL"
        },
        {
          "const": "ASK_CONFIRM"
        },
        {
          "const": "ASK_CORRECTION_TARGET"
        },
        {
          "const": "ASK_FINISH"
        },
        {
          "const": "RISK_NOTICE"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "WAIT_NOTICE"
        },
        {
          "const": "ASK_STOP"
        },
        {
          "const": "STAFF_NOTICE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "GuideItem": {
      "type": "object",
      "properties": {
        "guide_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        },
        "selection_criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "per_question": {
          "type": "boolean"
        },
        "sentence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "fill_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FillValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guide_id",
        "selection_criterion",
        "per_question",
        "sentence",
        "fill_value"
      ],
      "additionalProperties": false
    },
    "SessionSettings": {
      "type": "object",
      "properties": {
        "risk_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "confirm_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "unrecognized_streak_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "ask_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "fixed_sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedSentence"
          },
          "maxItems": 20
        },
        "guide_list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideItem"
          },
          "maxItems": 50
        }
      },
      "required": [
        "risk_phrases",
        "confirm_limit",
        "unrecognized_streak_limit",
        "ask_limit",
        "fixed_sentences",
        "guide_list"
      ],
      "additionalProperties": false
    }
  }
}