{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/PlannerRecord.json",
  "$ref": "#/$defs/PlannerRecord",
  "$defs": {
    "AskSubject": {
      "oneOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "object",
          "properties": {
            "untargeted": {
              "oneOf": [
                {
                  "const": "ASK_FINISH"
                },
                {
                  "const": "ASK_STOP"
                },
                {
                  "const": "ASK_CORRECTION_TARGET"
                }
              ]
            }
          },
          "required": [
            "untargeted"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PlannerRecord": {
      "type": "object",
      "properties": {
        "attempt_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "confirm_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "$ref": "#/$defs/SlotRef"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "slot",
              "count"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "unknown_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "refusal_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/QuestionId"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "question_id",
              "count"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "unrecognized_streak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "ask_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "$ref": "#/$defs/AskSubject"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "subject",
              "count"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "attempt_counts",
        "confirm_counts",
        "unknown_counts",
        "refusal_counts",
        "unrecognized_streak",
        "ask_counts"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/SlotRef"
        },
        {
          "$ref": "#/$defs/WholeQuestion"
        }
      ]
    },
    "WholeQuestion": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "whole_question": {
          "const": true
        }
      },
      "required": [
        "question_id",
        "whole_question"
      ],
      "additionalProperties": false
    }
  }
}