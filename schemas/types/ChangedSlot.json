{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/ChangedSlot.json",
  "$ref": "#/$defs/ChangedSlot",
  "$defs": {
    "ChangedSlot": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_value": {
          "$ref": "#/$defs/Value"
        },
        "kind": {
          "oneOf": [
            {
              "const": "FIRST_ANSWER"
            },
            {
              "const": "CORRECTION"
            }
          ]
        }
      },
      "required": [
        "slot",
        "previous_value",
        "new_value",
        "kind"
      ],
      "additionalProperties": false
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}