{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/UnitDef.json",
  "$ref": "#/$defs/UnitDef",
  "$defs": {
    "UnitDef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 10
        },
        "range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "convert_to": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "factor": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                }
              },
              "required": [
                "unit",
                "factor"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "synonyms",
        "range",
        "convert_to"
      ],
      "additionalProperties": false
    }
  }
}