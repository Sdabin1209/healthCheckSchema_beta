{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/Notice.json",
  "$ref": "#/$defs/Notice",
  "$defs": {
    "Notice": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/NoticeKind"
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "guide_id",
        "question_id",
        "question_name",
        "slot",
        "previous_value",
        "value"
      ],
      "additionalProperties": false
    },
    "NoticeKind": {
      "oneOf": [
        {
          "const": "CORRECTION_ACK"
        },
        {
          "const": "KEPT_PREVIOUS"
        },
        {
          "const": "RESUME"
        },
        {
          "const": "SURVEY_STOPPED"
        },
        {
          "const": "GUIDE"
        },
        {
          "const": "DEFERRED"
        }
      ]
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}