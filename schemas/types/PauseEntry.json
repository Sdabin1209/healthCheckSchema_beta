{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/PauseEntry.json",
  "$ref": "#/$defs/PauseEntry",
  "$defs": {
    "PauseEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PauseKind"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseReason"
          },
          "maxItems": 20
        }
      },
      "required": [
        "kind",
        "reasons"
      ],
      "additionalProperties": false
    },
    "PauseKind": {
      "oneOf": [
        {
          "const": "PAUSE"
        },
        {
          "const": "RESUME"
        }
      ]
    },
    "PauseReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_SIGNAL"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceText"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RISK_RULE"
            },
            "target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SlotRef"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}