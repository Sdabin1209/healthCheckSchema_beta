{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "types/UtteranceJudgment.json",
  "$ref": "#/$defs/UtteranceJudgment",
  "$defs": {
    "QuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
    },
    "Request": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RequestKind"
        },
        "guide_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_question_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_text": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceText"
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "kind",
        "guide_id",
        "target_question_id",
        "source_text"
      ],
      "additionalProperties": false
    },
    "RequestKind": {
      "oneOf": [
        {
          "const": "REPEAT"
        },
        {
          "const": "WAIT"
        },
        {
          "const": "LATER"
        },
        {
          "const": "STOP"
        },
        {
          "const": "GUIDE"
        },
        {
          "const": "STAFF_REQUEST"
        }
      ]
    },
    "SlotRef": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "repeat_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{0,64}$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9가-힣_.\\-]{1,64}$"
        }
      },
      "required": [
        "question_id",
        "repeat_key",
        "slot_id"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/SlotRef"
        },
        {
          "$ref": "#/$defs/WholeQuestion"
        }
      ]
    },
    "UtteranceJudgment": {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/UtteranceResult"
        },
        "valueless_correction_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValuelessCorrection"
          },
          "maxItems": 20
        },
        "confirmation": {
          "oneOf": [
            {
              "const": "YES"
            },
            {
              "const": "NO"
            },
            {
              "const": "NONE"
            }
          ]
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Request"
          },
          "maxItems": 20
        },
        "risk_signal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/SourceText"
                  },
                  "minItems": 1,
                  "maxItems": 20
                }
              },
              "required": [
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "result",
        "valueless_correction_requests",
        "confirmation",
        "requests",
        "risk_signal"
      ],
      "additionalProperties": false
    },
    "UtteranceResult": {
      "oneOf": [
        {
          "const": "HAS_ANSWER"
        },
        {
          "const": "REQUEST_ONLY"
        },
        {
          "const": "OUT_OF_SCOPE_ONLY"
        },
        {
          "const": "UNRECOGNIZED_TURN"
        }
      ]
    },
    "ValuelessCorrection": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "WholeQuestion": {
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "whole_question": {
          "const": true
        }
      },
      "required": [
        "question_id",
        "whole_question"
      ],
      "additionalProperties": false
    }
  }
}